{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "TEZCATL_WERROR": "ON"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows, MSVC (run from a VS developer shell)",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "cl" }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux, GCC",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "g++" }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux, Clang",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": { "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "linux-asan",
      "displayName": "Linux, Clang, AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "linux-coverage",
      "displayName": "Linux, GCC, --coverage (for scripts/self-report.sh)",
      "inherits": "linux-gcc",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "--coverage -O0",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage"
      }
    },
    {
      "name": "linux-tsan",
      "displayName": "Linux, Clang, ThreadSanitizer (the parallel parse)",
      "inherits": "linux-clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-msvc", "configurePreset": "windows-msvc" },
    { "name": "linux-gcc", "configurePreset": "linux-gcc" },
    { "name": "linux-clang", "configurePreset": "linux-clang" },
    { "name": "linux-asan", "configurePreset": "linux-asan" },
    { "name": "linux-tsan", "configurePreset": "linux-tsan" },
    { "name": "linux-coverage", "configurePreset": "linux-coverage" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "windows-msvc",
      "inherits": "base",
      "configurePreset": "windows-msvc"
    },
    { "name": "linux-gcc", "inherits": "base", "configurePreset": "linux-gcc" },
    {
      "name": "linux-clang",
      "inherits": "base",
      "configurePreset": "linux-clang"
    },
    {
      "name": "linux-asan",
      "inherits": "base",
      "configurePreset": "linux-asan"
    },
    {
      "name": "linux-coverage",
      "inherits": "base",
      "configurePreset": "linux-coverage"
    },
    {
      "name": "linux-tsan",
      "inherits": "base",
      "configurePreset": "linux-tsan",
      "environment": {
        "TSAN_OPTIONS": "suppressions=${sourceDir}/tests/tsan.supp halt_on_error=1"
      }
    }
  ]
}
